{
	"name": "rename-plus",
	"version": "1.0.0",
	"description": "Renomeador de arquivos e pastas em lote",
	"main": "build-electron/main/mainProcess.js",
	"desktopName": "rename-plus.desktop",
	"scripts": {
		"dev": "concurrently -k -n react,tsc,electron -c cyan,yellow,magenta \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:build-electron/main/mainProcess.js file:build-electron/preload/preloadBridge.js && cross-env ELECTRON_RUN_AS_NODE= VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
		"build": "npm run typecheck && npm run build:react && npm run build:electron",
		"build:react": "vite build",
		"build:electron": "tsc -p tsconfig.electron.json",
		"start": "cross-env ELECTRON_RUN_AS_NODE= electron .",
		"dist": "npm run build && electron-builder",
		"dist:dir": "npm run build && electron-builder --dir",
		"typecheck": "tsc -p tsconfig.react.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"ci": "biome ci . && npm run typecheck && npm test",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"type": "commonjs",
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"wait-on": "^9.5.1"
	},
	"private": true,
	"build": {
		"appId": "com.renameplus.app",
		"productName": "Rename Plus",
		"artifactName": "${name}-${version}-${os}-${arch}.${ext}",
		"directories": {
			"output": "build",
			"buildResources": "resources"
		},
		"files": [
			"build-electron/**/*",
			"build-react/**/*",
			"resources/icon.png",
			"package.json",
			"!**/*.map"
		],
		"icon": "resources/icon.png",
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Utility",
			"icon": "resources/icons",
			"desktop": {
				"entry": {
					"StartupWMClass": "rename-plus",
					"X-AppImage-Version": ""
				}
			}
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"artifactName": "${name}-${version}-${os}-${arch}.${ext}",
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Rename Plus"
		},
		"mac": {
			"target": [
				"dmg"
			]
		}
	}
}
